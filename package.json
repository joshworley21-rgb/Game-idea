{
  "name": "oval",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A single-player 3D president simulator: govern a modern nation while keeping your health, family and sanity intact.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "balance": "node --experimental-strip-types --no-warnings src/tools/balance.ts",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradle --no-daemon assembleDebug",
    "android:open": "cap open android",
    "assets": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@gltf-transform/cli": "^4.5.0",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
