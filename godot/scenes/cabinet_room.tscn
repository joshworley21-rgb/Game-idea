[gd_scene load_steps=9 format=3]

; The Cabinet Room: a table, six seats, and a camera that goes to whoever is
; tapped.
;
; Every measurement here is the web build's, from buildCabinetRoom() in
; src/world/rooms.ts, so the two versions of the room are the same room: an
; 11 x 8 shell 3.8 high, a 6.4 x 2.5 table at 0.76, and the six secretaries
; spread down the near side rather than bunched at one end -- the x values are
; that function's seat ring read in its own cabinet order.
;
; There is no Cabinet Room model to import the way main.tscn imports the
; Briefing Room, so the shell is boxes in the web build's own palette. The
; seats are markers, not furniture: cabinet_room.gd instantiates a suit model
; into each one at run time.

[ext_resource type="Script" path="res://godot/scripts/world/cabinet_room.gd" id="1_room"]
[ext_resource type="Script" path="res://godot/scripts/ui/dossier_card.gd" id="2_card"]

[sub_resource type="BoxMesh" id="BoxMesh_shell"]
size = Vector3(1, 1, 1)

[sub_resource type="StandardMaterial3D" id="Mat_floor"]
albedo_color = Color(0.435, 0.294, 0.18, 1)
roughness = 0.75

[sub_resource type="StandardMaterial3D" id="Mat_wall"]
albedo_color = Color(0.906, 0.863, 0.784, 1)
roughness = 0.9

[sub_resource type="StandardMaterial3D" id="Mat_carpet"]
albedo_color = Color(0.169, 0.29, 0.227, 1)
roughness = 0.95

[sub_resource type="StandardMaterial3D" id="Mat_table"]
albedo_color = Color(0.325, 0.192, 0.11, 1)
roughness = 0.35

[sub_resource type="Environment" id="Env_cabinet"]
background_mode = 1
background_color = Color(0.07, 0.07, 0.08, 1)
ambient_light_source = 2
ambient_light_color = Color(0.612, 0.659, 0.706, 1)
ambient_light_energy = 0.4
tonemap_mode = 3
tonemap_exposure = 0.85

; seats_root and dossier_card resolve by name too, but they are wired here as
; well. An exported Node reference in a hand-written .tscn only resolves when
; the node header lists it in node_paths -- without that it silently arrives
; null, which is the trap main.gd documents at length.
[node name="CabinetRoom" type="Node3D" node_paths=PackedStringArray("camera", "seats_root", "dossier_card")]
script = ExtResource("1_room")
camera = NodePath("Camera3D")
seats_root = NodePath("Seats")
dossier_card = NodePath("DossierCard")

[node name="Room" type="Node3D" parent="."]

[node name="Floor" type="MeshInstance3D" parent="Room"]
transform = Transform3D(11, 0, 0, 0, 0.1, 0, 0, 0, 8, 0, -0.05, 0)
mesh = SubResource("BoxMesh_shell")
surface_material_override/0 = SubResource("Mat_floor")

[node name="Carpet" type="MeshInstance3D" parent="Room"]
transform = Transform3D(8.5, 0, 0, 0, 0.02, 0, 0, 0, 5.5, 0, 0.01, 0)
mesh = SubResource("BoxMesh_shell")
surface_material_override/0 = SubResource("Mat_carpet")

[node name="Ceiling" type="MeshInstance3D" parent="Room"]
transform = Transform3D(11, 0, 0, 0, 0.1, 0, 0, 0, 8, 0, 3.85, 0)
mesh = SubResource("BoxMesh_shell")
surface_material_override/0 = SubResource("Mat_wall")

[node name="WallNorth" type="MeshInstance3D" parent="Room"]
transform = Transform3D(11, 0, 0, 0, 3.8, 0, 0, 0, 0.12, 0, 1.9, -4)
mesh = SubResource("BoxMesh_shell")
surface_material_override/0 = SubResource("Mat_wall")

[node name="WallSouth" type="MeshInstance3D" parent="Room"]
transform = Transform3D(11, 0, 0, 0, 3.8, 0, 0, 0, 0.12, 0, 1.9, 4)
mesh = SubResource("BoxMesh_shell")
surface_material_override/0 = SubResource("Mat_wall")

[node name="WallWest" type="MeshInstance3D" parent="Room"]
transform = Transform3D(0.12, 0, 0, 0, 3.8, 0, 0, 0, 8, -5.5, 1.9, 0)
mesh = SubResource("BoxMesh_shell")
surface_material_override/0 = SubResource("Mat_wall")

[node name="WallEast" type="MeshInstance3D" parent="Room"]
transform = Transform3D(0.12, 0, 0, 0, 3.8, 0, 0, 0, 8, 5.5, 1.9, 0)
mesh = SubResource("BoxMesh_shell")
surface_material_override/0 = SubResource("Mat_wall")

; 6.4 x 2.5, top at 0.76, which is boardTable()'s footprint in the web build.
[node name="Table" type="MeshInstance3D" parent="Room"]
transform = Transform3D(6.4, 0, 0, 0, 0.09, 0, 0, 0, 2.5, 0, 0.715, 0)
mesh = SubResource("BoxMesh_shell")
surface_material_override/0 = SubResource("Mat_table")

[node name="TablePlinth" type="MeshInstance3D" parent="Room"]
transform = Transform3D(5.2, 0, 0, 0, 0.67, 0, 0, 0, 1.5, 0, 0.335, 0)
mesh = SubResource("BoxMesh_shell")
surface_material_override/0 = SubResource("Mat_table")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_cabinet")

[node name="KeyLight" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 3.2, 0)
light_color = Color(1, 0.941, 0.847, 1)
light_energy = 3.5
omni_range = 16.0
shadow_enabled = true

[node name="FillWest" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3.4, 2.6, -2.4)
light_color = Color(1, 0.961, 0.898, 1)
light_energy = 1.2
omni_range = 9.0

[node name="FillEast" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.4, 2.6, -2.4)
light_color = Color(1, 0.961, 0.898, 1)
light_energy = 1.2
omni_range = 9.0

; One marker per office, in CoreData.OFFICES order: chief, treasury, state,
; defense, justice, health. Seat 1 is the chief and seat 6 is health, so the
; simulation's cabinet array fills them without a second list to keep in step.
;
; The x values come from the web build's `order = [3, 9, 1, 11, 5, 13]` read
; against its seat ring, which is why they are not in a tidy left-to-right
; run: the six are spread down the table rather than bunched at one end.
;
; All six sit at z = 1.84 with no rotation, so each marker's -Z points at the
; table. That is the convention cabinet_room.gd's focus maths is written to --
; the camera stands between the seat and the table, facing back at the seat.
[node name="Seats" type="Node3D" parent="."]

[node name="Seat1" type="Marker3D" parent="Seats"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.7, 0, 1.84)

[node name="Seat2" type="Marker3D" parent="Seats"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.85, 0, 1.84)

[node name="Seat3" type="Marker3D" parent="Seats"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.55, 0, 1.84)

[node name="Seat4" type="Marker3D" parent="Seats"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.7, 0, 1.84)

[node name="Seat5" type="Marker3D" parent="Seats"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.85, 0, 1.84)

[node name="Seat6" type="Marker3D" parent="Seats"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.55, 0, 1.84)

; Where the room opens from: the web build's spawn, by the east door, looking
; back down the table.
[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(0.6459, 0.0000, -0.7634, -0.1036, 0.9907, -0.0877, 0.7563, 0.1357, 0.6400, 3.9000, 1.7500, 3.3000)
current = true
fov = 70.0

[node name="DossierCard" type="CanvasLayer" parent="."]
script = ExtResource("2_card")
