[gd_scene load_steps=19 format=3]

; The Cabinet Room: a table, six seats, and a camera that goes to whoever is
; tapped.
;
; The shell used to be boxes in the web build's palette, because there was no
; Cabinet Room model to import. There is now: the pieces are the Conference Room
; pack, converted by scripts/convert-conference-room.mjs, which is where the
; conversion and every decision in it is written down.
;
; The pack ships its pieces modelled around their own origins rather than at
; their positions in the room -- the layout only ever existed in an Unreal
; .umap, which nothing outside Unreal reads -- so the arrangement below is
; authored rather than recovered. Every number in it is measured off the meshes:
; the floor is 12.00 x 8.00 and the walls 2.70 high, so the room is x -6..6,
; z -4..4, and each wall sits just outside that with its inner face on the line.
;
; Facings are measured too, not guessed. Chair_1 and Chair_2 carry their
; backrests at -Z and so face +Z; the sofa and armchair carry theirs at +X and
; face -X; the display's screen is the plane at its +X face. Anything placed
; against the run of those is turned here.

[ext_resource type="Script" path="res://godot/scripts/world/cabinet_room.gd" id="1_room"]
[ext_resource type="Script" path="res://godot/scripts/ui/dossier_card.gd" id="2_card"]
[ext_resource type="PackedScene" path="res://public/models/CR_Floor.glb" id="3_floor"]
[ext_resource type="PackedScene" path="res://public/models/CR_Ceiling.glb" id="4_ceiling"]
[ext_resource type="PackedScene" path="res://public/models/CR_FrontWall.glb" id="5_front"]
[ext_resource type="PackedScene" path="res://public/models/CR_NearWall.glb" id="6_near"]
[ext_resource type="PackedScene" path="res://public/models/CR_LeftWall.glb" id="7_left"]
[ext_resource type="PackedScene" path="res://public/models/CR_RightWall.glb" id="8_right"]
[ext_resource type="PackedScene" path="res://public/models/CR_Table.glb" id="9_table"]
[ext_resource type="PackedScene" path="res://public/models/CR_Chair1.glb" id="10_chair1"]
[ext_resource type="PackedScene" path="res://public/models/CR_Chair2.glb" id="11_chair2"]
[ext_resource type="PackedScene" path="res://public/models/CR_Display.glb" id="12_display"]
[ext_resource type="PackedScene" path="res://public/models/CR_Curtains.glb" id="13_curtains"]
[ext_resource type="PackedScene" path="res://public/models/CR_Door.glb" id="14_door"]
[ext_resource type="PackedScene" path="res://public/models/CR_DoorFrame.glb" id="15_frame"]
[ext_resource type="PackedScene" path="res://public/models/CR_Sofa.glb" id="16_sofa"]
[ext_resource type="PackedScene" path="res://public/models/CR_CoffeeTable.glb" id="17_coffee"]
[ext_resource type="PackedScene" path="res://public/models/CR_FloorLamp.glb" id="18_lamp"]

[sub_resource type="Environment" id="Env_cabinet"]
background_mode = 1
background_color = Color(0.07, 0.07, 0.08, 1)
ambient_light_source = 2
ambient_light_color = Color(0.612, 0.659, 0.706, 1)
ambient_light_energy = 0.35
tonemap_mode = 3
tonemap_exposure = 0.85

; seats_root and dossier_card resolve by name too, but they are wired here as
; well. An exported Node reference in a hand-written .tscn only resolves when
; the node header lists it in node_paths -- without that it silently arrives
; null, which is the trap main.gd documents at length.
[node name="CabinetRoom" type="Node3D" node_paths=PackedStringArray("camera", "seats_root", "dossier_card")]
script = ExtResource("1_room")
camera = NodePath("Camera3D")
seats_root = NodePath("Seats")
dossier_card = NodePath("DossierCard")

[node name="Room" type="Node3D" parent="."]

[node name="Floor" parent="Room" instance=ExtResource("3_floor")]

; The ceiling models -3.20..4.80 in z rather than centred, so it comes back 0.8
; to sit over the room, and up to the top of the walls.
[node name="Ceiling" parent="Room" instance=ExtResource("4_ceiling")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.7, -0.8)

; West end: the wall the display hangs on.
[node name="FrontWall" parent="Room" instance=ExtResource("5_front")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -6, 0, 0)

; East end, which carries the mirror.
[node name="NearWall" parent="Room" instance=ExtResource("6_near")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 6, 0, 0)

; North side: the glazed wall, which is why the curtains hang here.
[node name="LeftWall" parent="Room" instance=ExtResource("7_left")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -4.2)

; South side: panelled, and where the door is.
[node name="RightWall" parent="Room" instance=ExtResource("8_right")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 4)

[node name="Display" parent="Room" instance=ExtResource("12_display")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -5.99, 0.95, 0)

[node name="CurtainsWest" parent="Room" instance=ExtResource("13_curtains")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3.2, 0, -3.96)

[node name="CurtainsEast" parent="Room" instance=ExtResource("13_curtains")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.2, 0, -3.96)

[node name="DoorFrame" parent="Room" instance=ExtResource("15_frame")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -4, 0, 3.94)

[node name="Door" parent="Room" instance=ExtResource("14_door")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3.56, 0, 3.94)

; 6.65 x 1.90. Its own z runs -0.82..1.07, so it comes back 0.125 to sit square
; in the room; after that it spans z -0.945..0.945 and the chairs clear it.
[node name="Table" parent="Room" instance=ExtResource("9_table")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.125)

; The lounge end, against the east wall. The sofa and armchair face -X out of
; the box, which is into the room from that wall, so neither is turned.
[node name="Sofa" parent="Room" instance=ExtResource("16_sofa")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 5.4, 0, -2.2)

[node name="CoffeeTable" parent="Room" instance=ExtResource("17_coffee")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 4.3, 0, -2.2)

[node name="FloorLamp" parent="Room" instance=ExtResource("18_lamp")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 5.5, 0, -3.5)

; The six cabinet chairs, turned half round so their backs are to the room and
; they face the table. Their x values are the seat markers' below.
[node name="Chairs" type="Node3D" parent="."]

[node name="Chair1" parent="Chairs" instance=ExtResource("10_chair1")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, -1.7, 0, 1.35)

[node name="Chair2" parent="Chairs" instance=ExtResource("10_chair1")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0.85, 0, 1.35)

[node name="Chair3" parent="Chairs" instance=ExtResource("10_chair1")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, -2.55, 0, 1.35)

[node name="Chair4" parent="Chairs" instance=ExtResource("10_chair1")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 1.7, 0, 1.35)

[node name="Chair5" parent="Chairs" instance=ExtResource("10_chair1")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, -0.85, 0, 1.35)

[node name="Chair6" parent="Chairs" instance=ExtResource("10_chair1")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 2.55, 0, 1.35)

; The president's chair, at the head of the table looking down its length.
; Turned -90 degrees, which takes the chair's own +Z round to -X.
[node name="ChairHead" parent="Chairs" instance=ExtResource("10_chair1")]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 4.15, 0, -0.125)

; The far side of the table, empty. Chair_2 faces +Z already, which from here is
; the table, so these are not turned.
[node name="Far1" parent="Chairs" instance=ExtResource("11_chair2")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.4, 0, -1.6)

[node name="Far2" parent="Chairs" instance=ExtResource("11_chair2")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.8, 0, -1.6)

[node name="Far3" parent="Chairs" instance=ExtResource("11_chair2")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.8, 0, -1.6)

[node name="Far4" parent="Chairs" instance=ExtResource("11_chair2")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.4, 0, -1.6)

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_cabinet")

; Lit for a 2.7 metre ceiling: a key over the table and two fills down the room,
; all below the ceiling rather than in it.
[node name="KeyLight" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.45, 0)
light_color = Color(1, 0.941, 0.847, 1)
light_energy = 3.2
omni_range = 11.0
shadow_enabled = true

[node name="FillWest" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -4.2, 2.4, -1.2)
light_color = Color(1, 0.961, 0.898, 1)
light_energy = 1.4
omni_range = 8.0

[node name="FillEast" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 4.2, 2.4, -1.2)
light_color = Color(1, 0.961, 0.898, 1)
light_energy = 1.4
omni_range = 8.0

; Daylight through the glazed north wall, which is why it comes from -z.
[node name="WindowWash" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.5, 0.866, 0, -0.866, 0.5, 0, 2.2, -3.6)
light_color = Color(0.878, 0.918, 1, 1)
light_energy = 0.55

; One marker per office, in CoreData.OFFICES order: chief, treasury, state,
; defense, justice, health. Seat 1 is the chief and seat 6 is health, so the
; simulation's cabinet array fills them without a second list to keep in step.
;
; The x values come from the web build's `order = [3, 9, 1, 11, 5, 13]` read
; against its seat ring, which is why they are not in a tidy left-to-right
; run: the six are spread down the table rather than bunched at one end. They
; all fit inside this table, which is 6.65 long.
;
; z is 1.35, not the 1.84 the box shell used: the real table is shallower than
; the placeholder, and a seat has to be close enough that the occupant's knees
; reach under it. All six sit with no rotation, so each marker's -Z points at
; the table -- the convention cabinet_room.gd's focus maths is written to, and
; the one it turns the seated body against.
[node name="Seats" type="Node3D" parent="."]

[node name="Seat1" type="Marker3D" parent="Seats"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.7, 0, 1.35)

[node name="Seat2" type="Marker3D" parent="Seats"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.85, 0, 1.35)

[node name="Seat3" type="Marker3D" parent="Seats"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.55, 0, 1.35)

[node name="Seat4" type="Marker3D" parent="Seats"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.7, 0, 1.35)

[node name="Seat5" type="Marker3D" parent="Seats"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.85, 0, 1.35)

[node name="Seat6" type="Marker3D" parent="Seats"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.55, 0, 1.35)

; Across the table from the cabinet, which is where the president stands to
; read the room: the six are in frame together, the display is behind them.
[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(-1.0000, 0.0000, 0.0000, 0.0000, 0.9909, 0.1346, 0.0000, 0.1346, -0.9909, 0.0000, 1.7000, -2.7000)
current = true
fov = 70.0

[node name="DossierCard" type="CanvasLayer" parent="."]
script = ExtResource("2_card")
