[gd_scene load_steps=2 format=3]

; The scene is deliberately almost empty.
;
; It used to hold the Briefing Room, seven hand-written lights, three camera
; markers and an Environment — about sixty numbers, authored by hand in this
; file. Two of those numbers were wrong in ways nothing reported: the marker
; transforms were transposed, because Godot reads a Transform3D's nine floats
; as basis ROWS and they were written as columns, and the regex that produced
; them once dropped "transform = " and left a bare Transform3D(...) that broke
; scene parsing from that line down.
;
; All of it now lives in godot/scripts/world/rooms.gd as measurements and
; look-at points, built by World at runtime. A look-at point is a place in the
; room; it cannot be transposed, and it is obvious when it is wrong.

[ext_resource type="Script" path="res://godot/scripts/world/game_root.gd" id="1_game"]

[node name="Main" type="Node"]

[node name="Game" type="Node" parent="."]
script = ExtResource("1_game")
