# Cardboard Cutout Figure Template for President Simulator
# Scale: Tabletop / 1.6m game scale, 8mm thick board with triangular stand
mtllib cutout_stand.mtl
o CardboardCutout

# Cutout board geometry
v -0.2500 0.0000 0.0040
v 0.2500 0.0000 0.0040
v 0.2500 1.6000 0.0040
v -0.2500 1.6000 0.0040
v -0.2500 0.0000 -0.0040
v 0.2500 0.0000 -0.0040
v 0.2500 1.6000 -0.0040
v -0.2500 1.6000 -0.0040

# Triangular base stand
v -0.2000 0.0000 0.1800
v 0.2000 0.0000 0.1800
v 0.0000 0.0000 -0.2200
v -0.2000 0.0200 0.1800
v 0.2000 0.0200 0.1800
v 0.0000 0.0200 -0.2200

# Rear angled support strut
v -0.0200 0.0000 -0.0040
v 0.0200 0.0000 -0.0040
v -0.0200 0.6000 -0.0040
v 0.0200 0.6000 -0.0040
v -0.0200 0.0000 -0.2000
v 0.0200 0.0000 -0.2000

# Texture coordinates (UVs)
vt 0.0000 0.0000
vt 1.0000 0.0000
vt 1.0000 1.0000
vt 0.0000 1.0000
vt 0.0000 0.0000
vt 0.1000 0.0000
vt 0.1000 1.0000
vt 0.0000 1.0000

# Normals
vn 0.0000 0.0000 1.0000
vn 0.0000 0.0000 -1.0000
vn 1.0000 0.0000 0.0000
vn -1.0000 0.0000 0.0000
vn 0.0000 1.0000 0.0000
vn 0.0000 -1.0000 0.0000

# Front portrait face
usemtl CharacterPortrait
f 1/1/1 2/2/1 3/3/1 4/4/1

# Cardboard backing and corrugated rims
usemtl CardboardRim
f 6/1/2 5/2/2 8/3/2 7/4/2
