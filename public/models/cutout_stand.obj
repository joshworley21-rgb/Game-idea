# Cardboard Cutout Figure Template for President Simulator
# Scale: Tabletop / 1.6m game scale, 8mm thick board. Just the flat cutout
# board itself — no base plate or kickstand, per the user's call to drop the
# stand and keep the figure simple.
mtllib cutout_stand.mtl
o CardboardCutout

# Cutout board geometry
v -0.2500 0.0000 0.0040
v 0.2500 0.0000 0.0040
v 0.2500 1.6000 0.0040
v -0.2500 1.6000 0.0040
v -0.2500 0.0000 -0.0040
v 0.2500 0.0000 -0.0040
v 0.2500 1.6000 -0.0040
v -0.2500 1.6000 -0.0040

# Texture coordinates (UVs)
vt 0.0000 0.0000
vt 1.0000 0.0000
vt 1.0000 1.0000
vt 0.0000 1.0000
vt 0.0000 0.0000
vt 0.1000 0.0000
vt 0.1000 1.0000
vt 0.0000 1.0000

# Normals
vn 0.0000 0.0000 1.0000
vn 0.0000 0.0000 -1.0000
vn 1.0000 0.0000 0.0000
vn -1.0000 0.0000 0.0000
vn 0.0000 1.0000 0.0000
vn 0.0000 -1.0000 0.0000

# Front portrait face
usemtl CharacterPortrait
f 1/1/1 2/2/1 3/3/1 4/4/1

# Cardboard backing and corrugated rims
usemtl CardboardRim
f 6/5/2 5/6/2 8/7/2 7/8/2
f 2/5/3 6/6/3 7/7/3 3/8/3
f 5/5/4 1/6/4 4/7/4 8/8/4
f 4/5/5 3/6/5 7/7/5 8/8/5
f 1/5/6 5/6/6 6/7/6 2/8/6
