; Engine configuration file.
; Godot 4 project for the President Simulator port.
; This project intentionally lives at the repository root so Godot shares the
; same folder as the web build and can import res://public/models directly.
; The processed GLBs stay in public/models/ and are referenced from there as
; res://public/models/*.glb -- there is no duplicate copy under godot/models/.

config_version=5

[application]

config/name="President Simulator"
config/description="A single-player 3D president simulator: govern a modern nation while keeping your health, family and sanity intact."
config/version="0.1.0"
run/main_scene="res://godot/scenes/main.tscn"
; Godot reports a missing icon as an error on every Android export. It is not
; fatal, but an error line in a build log that is expected to be there is a
; line nobody reads the next time.
config/icon="res://godot/assets/icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

; Without a stretch mode Godot lays the interface out in real device pixels,
; so the same overlay that reads on a 1280x720 desktop window is a third of
; the size on a 2340x1080 phone — which is what the shipping target is. This
; keeps the layout at 720 high whatever the screen is, and lets the width
; grow with the aspect ratio rather than letterboxing a phone.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

; The rooms are wide and the dock runs along the bottom, so landscape. That
; is 0 in Godot's enum and not 1 — 1 is portrait, which is what this said
; first, and the only thing that caught it was reading the orientation back
; out of the built APK.
window/handheld/orientation=0

[rendering]

; Forward+ on the desktop, Mobile on Android. Forward+ needs Vulkan and is a
; gamble on a mid-range phone; the Mobile renderer drops SDFGI, SSAO, SSIL and
; volumetric fog but keeps real-time shadows and baked lightmaps, which is
; where this room's lighting is going anyway. The APK is the shipping target,
; so the phone gets the renderer that runs on it.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"

; Android refuses to export without this: the platform requires ETC2/ASTC and
; Godot will not ship textures the device cannot sample. It costs a second
; compressed copy of every texture under .godot/, which is not in git, and
; nothing at all at runtime on the desktop.
textures/vram_compression/import_etc2_astc=true
